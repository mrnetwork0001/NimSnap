# ---------------------------------------------------------------------------
# NimSnap configuration
# Copy to .env.local and fill in. Nothing here is required to run in demo mode.
# ---------------------------------------------------------------------------

# --- AI engine (required for real generations) ------------------------------
# Get a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Which image engine to use.
#   kontext (default) - FLUX.1 Kontext instruction editing. Best identity
#                       preservation, recommended for headshots and avatars.
#   sdxl              - SDXL img2img. Cheaper, more stylised drift.
REPLICATE_ENGINE=kontext
# REPLICATE_KONTEXT_MODEL=black-forest-labs/flux-kontext-pro
# REPLICATE_SDXL_MODEL=stability-ai/sdxl

# --- Payment treasuries -----------------------------------------------------
# Where shot payments land. At least one is required unless demo mode is on.
# These are NEXT_PUBLIC_ because the client builds the transaction; the server
# re-reads them independently when verifying, so they cannot be spoofed.

# Your Nimiq address, e.g. NQ07 0000 0000 0000 0000 0000 0000 0000 0000
NEXT_PUBLIC_NIM_TREASURY_ADDRESS=

# Your Polygon address for USDT, e.g. 0xabc...
NEXT_PUBLIC_USDT_TREASURY_ADDRESS=

# --- Demo mode --------------------------------------------------------------
# Lets the full flow run outside Nimiq Pay with no funds moving. The UI always
# says when this is on. Leave unset (or false) for a real deployment.
NEXT_PUBLIC_DEMO_MODE=false

# --- Chain access (optional, sane public defaults) --------------------------
# Public Nimiq indexer used to confirm NIM payments.
# NIMIQ_WATCH_API=https://api.nimiq.watch/api/v1
# Your own Albatross JSON-RPC node. Preferred over the indexer when set.
# NIMIQ_RPC_URL=
# Comma-separated Polygon RPCs used to confirm USDT payments.
# POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com,https://polygon.drpc.org

# --- Result storage ---------------------------------------------------------
# Replicate deletes model output after an hour, so finished images are copied
# somewhere durable before being handed to the user. Without S3_* configured
# they are written to public/results/ on local disk, which is right for a
# container or VM with a persistent volume, and wrong for serverless.
# Works with Cloudflare R2, AWS S3, Backblaze B2 — anything S3-compatible.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=nimsnap-results
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# Public base the bucket is readable from (a CDN domain, or an R2 public URL).
# S3_PUBLIC_BASE=https://cdn.example.com
# Local-disk fallback locations.
# RESULT_LOCAL_DIR=public/results
# RESULT_PUBLIC_BASE=/results

# --- Platform request budget ------------------------------------------------
# How long your host lets one request run. Vercel Hobby kills functions at 60s,
# Pro at 300s; a container is effectively unlimited. The server budgets
# settlement and generation to finish inside this, because overrunning means
# being killed with no response at all - after the user has paid.
# FUNCTION_BUDGET_MS=60000

# --- Order persistence (REQUIRED on serverless) -----------------------------
# Orders live in memory by default, which is correct for a single long-lived
# server and BROKEN on Vercel: the order is minted in one invocation and
# redeemed in another, and they do not share memory. The user pays, then the
# order 404s. Set these on any serverless host.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
